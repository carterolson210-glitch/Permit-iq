# Public — safe to expose to the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price IDs are NOT client env vars — the stripe-checkout edge function maps
# plan+billing to STRIPE_PRICE_* from its own secrets (see SETUP.md).

# Server-only — configure in Supabase Edge Function secrets, NOT in Vite env.
# Never prefix these with VITE_ or they will leak to the browser bundle.
# ANTHROPIC_API_KEY=sk-ant-xxx
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# RESEND_API_KEY=re_xxx
# CRON_SECRET=any-random-string — bearer token the re-engagement-email
#   function requires, so it can't be triggered by anyone but your cron job.

# Build-time only (read by scripts/generate-seo.ts via `npm run build`,
# never shipped to the browser) — the absolute URL baked into sitemap.xml
# and robots.txt. Defaults to the current Vercel domain if unset; set this
# in the Vercel project's env once a custom domain is live.
# SITE_URL=https://permit-iq-rho.vercel.app
